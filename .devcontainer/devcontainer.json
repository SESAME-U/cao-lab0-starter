{
  // Cloud Automation and Orchestration - SESAME University
  // Shared toolbox used for the whole semester.
  //
  // Use the lean base image to keep Codespaces image builds within disk limits.
  "name": "CAO toolbox",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",

  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest",
      "tflint": "latest"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  // 2-core is enough for every lab until Kubernetes (week 10).
  "hostRequirements": {
    "cpus": 2
  },

  "postCreateCommand": "bash scripts/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "redhat.ansible",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-azureresourcegroups",
        "github.vscode-github-actions"
      ],
      "settings": {
        "files.trimTrailingWhitespace": true,
        "editor.formatOnSave": true
      }
    }
  }
}
